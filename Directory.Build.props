<Project>

  <!--
    Applies to every project in the solution (API, Tests) so analyzer coverage cannot drift
    between them.

    AnalysisMode=Recommended raises the .NET analyzer set above the default. It is what surfaces
    CA1859 (interface parameter/return where the concrete type is always passed) across the whole
    solution rather than only in the highest-confidence production cases. Per-rule severity
    overrides continue to live in .editorconfig and still win over this setting.

    EnforceCodeStyleInBuild is deliberately NOT enabled: it would activate IDE1006 naming analysis
    at build time, which currently reports 514 violations against the established `_camelCase`
    field convention. Style rules stay a `dotnet format` concern.
  -->
  <PropertyGroup>
    <AnalysisMode>Recommended</AnalysisMode>
  </PropertyGroup>

</Project>
