<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <UseAppHost>true</UseAppHost>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="..\ProcessPipe.cs" Link="ProcessPipe.cs" />
  </ItemGroup>
  <Target Name="GetCacheClearFiles" DependsOnTargets="Build" Returns="@(CacheClearFiles)">
    <ItemGroup>
      <CacheClearFiles Include="$(TargetDir)$(AssemblyName).dll;$(TargetDir)$(AssemblyName).deps.json;$(TargetDir)$(AssemblyName).runtimeconfig.json" />
      <CacheClearFiles Include="$(TargetDir)$(AssemblyName).exe" Condition="$([MSBuild]::IsOSPlatform('Windows'))" />
      <CacheClearFiles Include="$(TargetDir)$(AssemblyName)" Condition="!$([MSBuild]::IsOSPlatform('Windows'))" />
    </ItemGroup>
  </Target>
</Project>
