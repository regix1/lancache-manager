#!/bin/sh
set -e

# Invisible-Unicode gate. Zero-width, bidi and tag characters carry no glyph, so hidden
# text pasted into source is unreadable in review. Runs before the cd because it resolves
# staged paths relative to the repo root.
INVISIBLES="$HOME/.githooks/pre-commit"
if [ -x "$INVISIBLES" ]; then
  "$INVISIBLES" || exit 1
fi

ROOT="$(git rev-parse --show-toplevel)"
cd "$ROOT/Web"

# lint-staged runs eslint --fix + prettier --write over the staged files and re-stages
# what it fixed, so formatting drift can never reach a commit (and never reach CI as a
# lint warning nobody reads).
echo "pre-commit: formatting staged files..."
npx lint-staged

echo "pre-commit: running knip..."
npm run knip
