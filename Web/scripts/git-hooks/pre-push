#!/bin/sh
set -e

ROOT="$(git rev-parse --show-toplevel)"

cd "$ROOT/Web"

# Only the fast checks run here. The frontend tests and the backend build and tests run in CI
# (lint.yml, called by docker-build-dev.yml on every push to main), so repeating them here only
# delayed the push. The spelling check covers every tracked file, not just the push, so text that
# predates the rule is caught too.
echo "pre-push: checking the LANCache spelling..."
node scripts/validate-lancache-spelling.mjs

echo "pre-push: checking timestamp formatting..."
npm run validate:timestamps

echo "pre-push: validating message and deadline contracts..."
npm run validate:contracts

echo "pre-push: running knip..."
npm run knip

cd "$ROOT"

# Keep passive top-level declarations in model files so implementation files retain one concern.
MODEL_SCRIPT="$ROOT/scripts/csharp-model-placement.ps1"
echo "pre-push: checking C# model placement..."
if command -v pwsh >/dev/null 2>&1; then
  pwsh -NoProfile -File "$MODEL_SCRIPT" -RequireTracked
elif command -v pwsh.exe >/dev/null 2>&1; then
  if command -v wslpath >/dev/null 2>&1; then
    MODEL_SCRIPT="$(wslpath -w "$MODEL_SCRIPT")"
  fi
  pwsh.exe -NoProfile -File "$MODEL_SCRIPT" -RequireTracked
else
  echo "pre-push: PowerShell 7 not found - cannot check C# model placement." >&2
  exit 1
fi
