{
  "Logging": {
    "LogLevel": {
      "Default": "Warning",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.AspNetCore.SignalR": "Warning",
      "Microsoft.AspNetCore.SignalR.Internal": "None",
      "Microsoft.EntityFrameworkCore": "Error",
      "Microsoft.EntityFrameworkCore.Database.Command": "None",
      "Microsoft.EntityFrameworkCore.Database": "None",
      "Microsoft.Extensions.Hosting": "Warning",
      "System.Net.Http.HttpClient": "Warning",
      "LancacheManager": "Information",
      "LancacheManager.Security": "Warning",
      "Microsoft.AspNetCore.Authentication": "Warning",
      "Microsoft.AspNetCore.Antiforgery": "None"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "DefaultConnection": "Host=/var/run/postgresql;Database=lancache;Username=lancache;Maximum Pool Size=20;Minimum Pool Size=2"
  },
  "LanCache": {
    "CachePath": "cache"
  },
  "Security": {
    "EnableAuthentication": true,
    "RequireAuthForMetrics": false,
    "GuestSessionDurationHours": 6,
    "AllowedOrigins": "",
    "ForceSecureCookies": false
  },
  "NginxLogRotation": {
    "Enabled": true,
    "ContainerName": "",
    "ScheduleHours": 24
  },
  "ApiOptions": {
    "MaxClientsPerRequest": 1000,
    "DefaultClientsLimit": 100
  }
}
